    <dynamic-element field-reference="description" index-type="keyword" instance-id="descrip1" name="Text50680698" type="text">
        <dynamic-content language-id="en_US"><![CDATA[NIC LDAP authenticates buyers, who can also invite suppliers. Seller onboarding separates organization details, personal checks, email verification and credentials. Self-help group missions can showcase their members’ products.]]></dynamic-content>
        <dynamic-content language-id="hi_IN"><![CDATA[एनआईसी एलडीएपी खरीदारों का प्रमाणीकरण करता है। खरीदार आपूर्तिकर्ताओं को आमंत्रित भी कर सकते हैं। विक्रेता पंजीकरण में संगठन विवरण, व्यक्तिगत सत्यापन, ईमेल सत्यापन और लॉगिन विवरण अलग चरण हैं। स्वयं सहायता समूहों के मिशन अपने सदस्यों के उत्पाद प्रदर्शित कर सकते हैं।]]></dynamic-content>
