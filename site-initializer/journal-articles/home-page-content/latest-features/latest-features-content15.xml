    <dynamic-element field-reference="description" index-type="keyword" instance-id="descrip1" name="Text50680698" type="text">
        <dynamic-content language-id="en_US"><![CDATA[GeM applies certain incident actions across seller accounts sharing a PAN. Its waiver mechanism considers transaction history and amounts owed. The system can act after 15 days without a reply to a show-cause notice.]]></dynamic-content>
        <dynamic-content language-id="hi_IN"><![CDATA[जेम समान पैन वाले विक्रेता खातों पर कुछ घटना-संबंधी कार्रवाइयाँ लागू करता है। छूट तय करते समय लेनदेन का इतिहास और बकाया राशि देखी जाती है। कारण बताओ नोटिस का 15 दिन में उत्तर न मिलने पर प्रणाली कार्रवाई कर सकती है।]]></dynamic-content>
