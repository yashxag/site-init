    <dynamic-element field-reference="description" index-type="keyword" instance-id="descrip1" name="Text50680698" type="text">
        <dynamic-content language-id="en_US"><![CDATA[Buyers can purchase single-day services, select multiple consignees for direct purchases, schedule pre-bid meetings for eligible services and request cancellation before service starts. GeM also added a floor-price preview.]]></dynamic-content>
        <dynamic-content language-id="hi_IN"><![CDATA[खरीदार एक दिन की सेवा खरीद सकते हैं, सीधी खरीद में कई प्राप्तकर्ता चुन सकते हैं, पात्र सेवाओं के लिए बोली-पूर्व बैठक तय कर सकते हैं और सेवा शुरू होने से पहले रद्दीकरण का अनुरोध कर सकते हैं। जेम ने न्यूनतम मूल्य का पूर्वावलोकन भी जोड़ा।]]></dynamic-content>
